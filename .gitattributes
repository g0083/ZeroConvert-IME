* text=auto
*.py text eol=lf
*.rs text eol=lf
*.swift text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.json text eol=lf
.gitmodules text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.yml text eol=lf
